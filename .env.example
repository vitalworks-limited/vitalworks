NEXT_PUBLIC_SITE_URL=https://www.vitalworks.example

# Configure these only after approving a company-controlled HTTPS endpoint.
# All three values are server-side configuration; do not use NEXT_PUBLIC_ for secrets.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_ALLOWED_HOST=
INQUIRY_WEBHOOK_TOKEN=

# Set true only after content approval, browser testing, release and SEO signoff.
NEXT_PUBLIC_SITE_PUBLISHED=false
